# Copy to .env and fill in your keys/models

# Required keys (when real providers are wired):
# OPENAI_API_KEY=...
# GOOGLE_API_KEY=...
# XAI_API_KEY=...

# Optional model names:
GPT5_MODEL=gpt5
GEMINI_MODEL=gemini-2.5-pro
GROK_MODEL=grok-4

# Enable deterministic offline behavior for testing
DIALECTICA_DRY_RUN=1

# Literature search configuration
# Enable literature search during idea generation (default: 0)
DIALECTICA_LITERATURE_SEARCH=0

# Optional Semantic Scholar API key for higher rate limits
# SEMANTIC_SCHOLAR_API_KEY=...
